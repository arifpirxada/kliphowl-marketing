# Environment Variables for KlipHowl Marketing Tools

# Google / YouTube Data API v3 Key
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Optional: GitHub Personal Access Token (for checking developer bios & emails without strict rate limits)
GITHUB_TOKEN=your_github_token_here

# Local Database Path (defaults to data/marketing.db)
DATABASE_PATH=data/marketing.db

# Admin email for notifications etc.
ADMIN_EMAIL=kliphowl@gmail.com

# Sender Information
SENDER_NAME="Arif"
SENDER_EMAIL="your_outreach_email@domain.com"
PRODUCT_NAME="KlipHowl"
PRODUCT_DEMO_URL="https://kliphowl.com"

# Email / Brevo SMTP
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
EMAIL_FROM=
